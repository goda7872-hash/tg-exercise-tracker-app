# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tg_exercise_tracker"

# NextAuth  (generate secret with: openssl rand -base64 32)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Comma-separated emails that become coaches (ADMIN) on login
ADMIN_EMAILS="you@gmail.com"

# Optional: coach email used by `prisma db seed` (defaults to first ADMIN_EMAILS)
SEED_COACH_EMAIL=""

# Telegram notifications to the coach (optional)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID="1220406972"
