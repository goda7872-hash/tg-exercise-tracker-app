generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CLIENT
}

enum ExerciseCategory {
  STRENGTH
  CARDIO
  MOBILITY
  CONDITIONING
}

enum BlockStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum DayStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  LOCKED
}

// ---------- Auth (NextAuth Prisma adapter) ----------
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          UserRole  @default(CLIENT)
  timezone      String    @default("UTC")
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  coachedClients Client[]  @relation("CoachToClient")
  clientProfile  Client?   @relation("ClientUser")
  loggedSets     LoggedSet[]
  cardioLogs     CardioLog[]
  dayNotes       DayNote[]

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Coach / client ----------
model Client {
  id        String   @id @default(cuid())
  coachId   String
  userId    String   @unique
  startDate DateTime @db.Date
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coach          User            @relation("CoachToClient", fields: [coachId], references: [id], onDelete: Cascade)
  user           User            @relation("ClientUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedBlocks AssignedBlock[]

  @@index([coachId])
}

// ---------- Exercise library ----------
model ExerciseMaster {
  id          String           @id @default(cuid())
  coachId     String
  name        String
  category    ExerciseCategory
  description String?
  notes       String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  blockExercises BlockExercise[]
  cardioLogs     CardioLog[]

  @@unique([coachId, name])
  @@index([coachId])
}

// ---------- Templates ----------
model WorkoutBlockTemplate {
  id            String   @id @default(cuid())
  coachId       String
  name          String
  description   String?
  durationWeeks Int
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  weeks          WeekTemplate[]
  assignedBlocks AssignedBlock[]

  @@unique([coachId, name])
  @@index([coachId])
}

model WeekTemplate {
  id              String @id @default(cuid())
  blockTemplateId String
  weekNumber      Int

  blockTemplate WorkoutBlockTemplate @relation(fields: [blockTemplateId], references: [id], onDelete: Cascade)
  days          DayTemplate[]

  @@unique([blockTemplateId, weekNumber])
}

model DayTemplate {
  id             String @id @default(cuid())
  weekTemplateId String
  dayNumber      Int
  dayName        String

  weekTemplate   WeekTemplate    @relation(fields: [weekTemplateId], references: [id], onDelete: Cascade)
  blockExercises BlockExercise[]
  assignedDays   AssignedDay[]

  @@unique([weekTemplateId, dayNumber])
}

model BlockExercise {
  id               String  @id @default(cuid())
  dayTemplateId    String
  exerciseMasterId String
  exerciseOrder    Int
  isCardio         Boolean @default(false)
  targetSets       Int
  targetReps       String?

  dayTemplate    DayTemplate    @relation(fields: [dayTemplateId], references: [id], onDelete: Cascade)
  exerciseMaster ExerciseMaster @relation(fields: [exerciseMasterId], references: [id], onDelete: Restrict)
  assignedSets   AssignedSet[]

  @@unique([dayTemplateId, exerciseOrder])
  @@index([exerciseMasterId])
}

// ---------- Assigned (client instances) ----------
model AssignedBlock {
  id              String      @id @default(cuid())
  clientId        String
  templateId      String
  startDate       DateTime    @db.Date
  expectedEndDate DateTime    @db.Date
  actualEndDate   DateTime?   @db.Date
  status          BlockStatus @default(ACTIVE)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  client   Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  template WorkoutBlockTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  weeks    AssignedWeek[]

  @@index([clientId])
  @@index([templateId])
  @@index([status])
}

model AssignedWeek {
  id                 String   @id @default(cuid())
  assignedBlockId    String
  weekTemplateId     String
  weekNumber         Int
  scheduledStartDate DateTime @db.Date
  scheduledEndDate   DateTime @db.Date

  assignedBlock AssignedBlock @relation(fields: [assignedBlockId], references: [id], onDelete: Cascade)
  days          AssignedDay[]

  @@unique([assignedBlockId, weekNumber])
}

model AssignedDay {
  id            String    @id @default(cuid())
  assignedWeekId String
  dayTemplateId String
  dayNumber     Int
  dayName       String
  scheduledDate DateTime  @db.Date
  isRestDay     Boolean   @default(false)
  status        DayStatus @default(PENDING)
  submittedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  assignedWeek AssignedWeek @relation(fields: [assignedWeekId], references: [id], onDelete: Cascade)
  dayTemplate  DayTemplate  @relation(fields: [dayTemplateId], references: [id], onDelete: Restrict)
  assignedSets AssignedSet[]
  cardioLogs   CardioLog[]
  dayNotes     DayNote[]

  @@unique([assignedWeekId, dayNumber])
  @@index([status])
}

model AssignedSet {
  id              String @id @default(cuid())
  assignedDayId   String
  blockExerciseId String
  setNumber       Int
  orderInDay      Int

  assignedDay   AssignedDay   @relation(fields: [assignedDayId], references: [id], onDelete: Cascade)
  blockExercise BlockExercise @relation(fields: [blockExerciseId], references: [id], onDelete: Restrict)
  loggedSet     LoggedSet?

  @@unique([assignedDayId, blockExerciseId, setNumber])
  @@index([blockExerciseId])
}

// One result row per assigned set. Re-submitting a day overwrites it (history goes to AuditLog).
model LoggedSet {
  id            String   @id @default(cuid())
  userId        String
  assignedSetId String   @unique
  weight        Float?
  reps          Int?
  rpe           Int?
  notes         String?
  isSkipped     Boolean  @default(false)
  loggedAt      DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedSet AssignedSet @relation(fields: [assignedSetId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([loggedAt])
}

model CardioLog {
  id               String   @id @default(cuid())
  userId           String
  assignedDayId    String
  exerciseMasterId String
  exerciseOrder    Int
  duration         Int?
  speed            Float?
  distance         Float?
  notes            String?
  loggedAt         DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedDay AssignedDay    @relation(fields: [assignedDayId], references: [id], onDelete: Cascade)
  exercise    ExerciseMaster @relation(fields: [exerciseMasterId], references: [id], onDelete: Restrict)

  @@unique([assignedDayId, exerciseOrder])
  @@index([userId])
}

model DayNote {
  id            String   @id @default(cuid())
  userId        String
  assignedDayId String
  note          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedDay AssignedDay @relation(fields: [assignedDayId], references: [id], onDelete: Cascade)

  @@unique([userId, assignedDayId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  tableName String
  recordId  String
  oldValues Json?
  newValues Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tableName, recordId])
}
